Cell[CellGroupData[{

Cell["Plot", "Section",ExpressionUUID->"6e9784bf-65c4-4ba7-8439-1a6f1fc516fb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", 
         "\"\<Fig1b_trajs.csv\>\""}], "}"}], "]"}], ",", "\"\<CSV\>\""}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panels", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ListDensityPlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Log10", "[", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", 
               RowBox[{"2", ";;"}]}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"Log10", "[", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", 
               RowBox[{"2", ";;"}]}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"m", "+", "3"}], ",", 
              RowBox[{"2", ";;"}]}], "]"}], "]"}]}], "}"}], "]"}], ",", 
        RowBox[{"InterpolationOrder", "->", "0"}], ",", 
        RowBox[{"ColorFunction", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "\"\<AvocadoColors\>\"", "]"}], "[", 
            RowBox[{"#", "/", "0.6"}], "]"}], "&"}], ")"}]}], ",", 
        RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
        RowBox[{"FrameTicksStyle", "->", "14"}], ",", 
        RowBox[{"FrameTicks", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"p", ",", 
                 RowBox[{"Superscript", "[", 
                  RowBox[{"10", ",", "p"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"p", ",", "6", ",", "9"}], "}"}]}], "]"}], ",", 
             "None"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"p", ",", 
                 RowBox[{"Superscript", "[", 
                  RowBox[{"10", ",", "p"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"p", ",", "3", ",", "8"}], "}"}]}], "]"}], ",", 
             "None"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"Epilog", "->", 
         RowBox[{"{", 
          RowBox[{"Inset", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"ToString", "[", "m", "]"}], ",", "White", ",", "Bold", 
              ",", "20"}], "]"}], ",", 
            RowBox[{"Scaled", "[", 
             RowBox[{"{", 
              RowBox[{"0.90", ",", "0.1"}], "}"}], "]"}]}], "]"}], "}"}]}], 
        ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{"All", ",", "All", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0.6"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"PlotRangePadding", "->", "None"}], ",", 
        RowBox[{"ImageSize", "->", "250"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "1", ",", "10"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"figS2", "=", 
    RowBox[{"Legended", "[", 
     RowBox[{
      RowBox[{"Labeled", "[", 
       RowBox[{
        RowBox[{"GraphicsGrid", "[", 
         RowBox[{
          RowBox[{"Partition", "[", 
           RowBox[{"panels", ",", "5"}], "]"}], ",", 
          RowBox[{"Spacings", "->", 
           RowBox[{"{", 
            RowBox[{"0.1", ",", "0.1"}], "}"}]}], ",", 
          RowBox[{"ImageSize", "->", "1250"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<\!\(\*SubscriptBox[\(k\), \(S\)]\) (s\:207b\.b9)\>\"", ",", 
            "Bold", ",", "14"}], "]"}], ",", 
          RowBox[{"Rotate", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<\!\(\*SubscriptBox[\(k\), \(T\)]\) (s\:207b\.b9)\>\"", ",", 
              "Bold", ",", "14"}], "]"}], ",", 
            RowBox[{"Pi", "/", "2"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Bottom", ",", "Left"}], "}"}]}], "]"}], ",", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"BarLegend", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<AvocadoColors\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0.6"}], "}"}]}], "}"}], ",", 
          RowBox[{"LegendLabel", "->", "\"\<Logarithmic Negativity\>\""}], 
          ",", 
          RowBox[{"LabelStyle", "->", "14"}], ",", 
          RowBox[{"LegendLayout", "->", "\"\<Row\>\""}], ",", 
          RowBox[{"LegendMarkerSize", "->", "600"}]}], "]"}], ",", "Below"}], 
       "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", "figS2"}], "Input",
