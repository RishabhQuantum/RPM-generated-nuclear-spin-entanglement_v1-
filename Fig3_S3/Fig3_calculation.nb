Cell[BoxData[{
 RowBox[{
  RowBox[{"Ncyc", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhon", "=", 
   FractionBox[
    RowBox[{"IdentityMatrix", "[", "M", "]"}], "M"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trajs", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ks", ",", "kt"}], "}"}], "=", "pair"}], ";", 
      RowBox[{"solve", "=", 
       RowBox[{"LinearSolve", "[", "LL", "]"}]}], ";", 
      RowBox[{"states", "=", 
       RowBox[{"NestList", "[", 
        RowBox[{"OneCyc", ",", "rhon", ",", "Ncyc"}], "]"}]}], ";", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", 
